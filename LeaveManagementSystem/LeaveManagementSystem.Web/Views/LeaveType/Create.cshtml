@model LeaveManagementSystem.Web.Data.LeaveType

@{
    ViewData["Title"] = "Create Leave Type";
}

<section class="lms-page-header">
    <div class="container">
        <span class="eyebrow">New</span>
        <h1 class="lms-page-title">Create Leave Type</h1>
        <p class="lms-page-subtitle">Add a new leave category with its allowance and validity period.</p>
    </div>
</section>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form asp-action="Create" method="post" class="lms-form-card">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <div class="col-12">
                        <label asp-for="LeaveTypeName" class="form-label"></label>
                        <input asp-for="LeaveTypeName" class="form-control" placeholder="e.g. Annual Leave" />
                        <span asp-validation-for="LeaveTypeName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NumberOfDays" class="form-label"></label>
                        <input asp-for="NumberOfDays" class="form-control" />
                        <span asp-validation-for="NumberOfDays" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6"></div>

                    <div class="col-md-6">
                        <label asp-for="FromDate" class="form-label"></label>
                        <input asp-for="FromDate" type="date" class="form-control" />
                        <span asp-validation-for="FromDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ToDate" class="form-label"></label>
                        <input asp-for="ToDate" type="date" class="form-control" />
                        <span asp-validation-for="ToDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-gradient btn-lg px-4">Save</button>
                    <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}