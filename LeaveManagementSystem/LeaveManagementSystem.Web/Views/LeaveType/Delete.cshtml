            @model LeaveManagementSystem.Web.Data.LeaveType

@{
    ViewData["Title"] = "Delete Leave Type";
}

<section class="lms-page-header">
    <div class="container">
        <span class="eyebrow">Confirm</span>
        <h1 class="lms-page-title">Delete Leave Type</h1>
        <p class="lms-page-subtitle">This action cannot be undone.</p>
    </div>
</section>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="lms-form-card lms-danger-card">
                <p class="mb-4">Are you sure you want to delete <strong>@Model.LeaveTypeName</strong>?</p>

                <dl class="row g-3 mb-0">
                    <dt class="col-sm-4 text-muted">Number of Days</dt>
                    <dd class="col-sm-8 mb-0">@Model.NumberOfDays</dd>

                    <dt class="col-sm-4 text-muted">From Date</dt>
                    <dd class="col-sm-8 mb-0">@Model.FromDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted">To Date</dt>
                    <dd class="col-sm-8 mb-0">@Model.ToDate.ToString("dd MMM yyyy")</dd>
                </dl>

                <hr class="my-4" />

                <form asp-action="Delete" asp-route-id="@Model.LeaveId" method="post" class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger btn-lg px-4">Yes, Delete</button>
                    <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>