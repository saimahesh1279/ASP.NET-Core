@{
    ViewData["Title"] = "Pricing";
}

<section class="pricing-page">
    <div class="container py-5">
        <div class="text-center mb-5">
            <p class="pricing-kicker">Simple pricing</p>
            <h1 class="display-5 fw-bold mb-3">Choose the plan that fits your team</h1>
            <p class="pricing-intro mx-auto">
                Flexible service tiers for growing teams, from lightweight scheduling to full operational oversight.
            </p>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-4">
                <article class="pricing-card">
                    <div class="pricing-card__header">
                        <p class="plan-name">Starter</p>
                        <h2>$19<span>/month</span></h2>
                    </div>

                    <ul class="feature-list">
                        <li>Up to 5 team members</li>
                        <li>Basic leave tracking</li>
                        <li>Approval workflow</li>
                        <li>Email notifications</li>
                        <li>Monthly reporting</li>
                    </ul>

                    <button type="button" class="btn btn-outline-primary pricing-button">Get started</button>
                </article>
            </div>

            <div class="col-lg-4">
                <article class="pricing-card pricing-card--featured">
                    <div class="pricing-badge">Most popular</div>
                    <div class="pricing-card__header">
                        <p class="plan-name">Growth</p>
                        <h2>$49<span>/month</span></h2>
                    </div>

                    <ul class="feature-list">
                        <li>Unlimited team members</li>
                        <li>Advanced leave policies</li>
                        <li>Manager dashboards</li>
                        <li>Custom approval chains</li>
                        <li>Dedicated support</li>
                    </ul>

                    <button type="button" class="btn btn-primary pricing-button">Choose Growth</button>
                </article>
            </div>

            <div class="col-lg-4">
                <article class="pricing-card">
                    <div class="pricing-card__header">
                        <p class="plan-name">Enterprise</p>
                        <h2>$99<span>/month</span></h2>
                    </div>

                    <ul class="feature-list">
                        <li>Custom onboarding</li>
                        <li>Role-based access</li>
                        <li>Audit trail reporting</li>
                        <li>Priority support</li>
                        <li>Custom integrations</li>
                    </ul>

                    <button type="button" class="btn btn-outline-primary pricing-button">Talk to sales</button>
                </article>
            </div>
        </div>
    </div>
</section>
