@model TestViewModel
@{
    ViewData["Title"] = "Test View Model";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="text-center mb-5">
                <span class="eyebrow">Leave Management System</span>
                <h1 class="display-5 fw-bold section-title">Test View Model</h1>
                <p class="lead text-muted mb-0">A quick overview of the information available for this account.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="lms-card lms-card-accent accent-indigo h-100">
                        <div class="card-body p-4">
                            <span class="stat-badge badge-indigo">Welcome</span>
                            <h2 class="h4 fw-bold mt-3">Hello</h2>
                            <p class="text-muted mb-0">Hello from the Test controller.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="lms-card lms-card-accent accent-emerald h-100">
                        <div class="card-body p-4">
                            <span class="stat-badge badge-emerald">Employee</span>
                            <h2 class="h4 fw-bold mt-3">Name</h2>
                            <p class="text-muted mb-0">
                                Your name is <span class="fw-semibold text-dark">@Model.Name</span>.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="lms-card lms-card-accent accent-amber h-100">
                        <div class="card-body p-4">
                            <span class="stat-badge badge-amber">Profile</span>
                            <h2 class="h4 fw-bold mt-3">Date of birth</h2>
                            @if (Model.DateofBirth.HasValue)
                            {
                                <p class="text-muted mb-0">
                                    @Model.DateofBirth.Value.ToString("MM/dd/yyyy")
                                </p>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Not provided.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>