@model TestViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Tittle"] = "Test View Model";
}
<div class="container">
    <div class="row">

        <div class="col-md-4">
            <h4>Hello from Test Controller</h4>
        </div>

        <div class="col-md-4">
            <h4>Your name is: @Model.Name</h4>
        </div>

        <div class="col-md-4">
            @if (Model.DateofBirth.HasValue)
            {
                <h4>
                    Your date of birth is:
                    @Model.DateofBirth.Value.ToString("MM/dd/yyyy")
                </h4>
            }
        </div>

    </div>
</div>