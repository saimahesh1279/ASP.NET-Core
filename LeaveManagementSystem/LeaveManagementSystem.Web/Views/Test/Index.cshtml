@model TestViewModel
@{
    ViewData["Title"] = "Test View Model";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="text-center mb-5">
            <span class="badge rounded-pill text-bg-primary mb-3">Leave Management System</span>
            <h1 class="display-4 fw-semibold">Test View Model</h1>
            <p class="lead text-muted mb-0">A quick overview of the information available for this account.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4">Welcome</h2>
                        <p class="text-muted mb-0">Hello from the Test controller.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4">Employee</h2>
                        <p class="text-muted mb-0">
                            Your name is <span class="fw-semibold text-dark">@Model.Name</span>.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4">Date of birth</h2>
                        @if (Model.DateofBirth.HasValue)
                        {
                            <p class="text-muted mb-0">
                                @Model.DateofBirth.Value.ToString("MM/dd/yyyy")
                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Not provided.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>